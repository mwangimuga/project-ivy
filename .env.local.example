# ── Supabase ─────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Paystack ─────────────────────────────────────────────────
# Get these from: dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

# ── Cron ─────────────────────────────────────────────────────
# Any random string. Vercel sends it as `Authorization: Bearer <value>`
# on scheduled hits to /api/cron/charge-rent (see vercel.json).
CRON_SECRET=change-me-to-a-random-string
